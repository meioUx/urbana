PORT=3000
HOST=127.0.0.1
# Optional. Without DATABASE_URL, uses SQLite in ./data.
# DATABASE_URL=postgres://urban:urban@localhost:5432/urban
# Set before first startup; never use demonstration passwords on a public server.
# `npm start` (--production) refuses to start when HOST is not loopback (or SECURE_COOKIE=true) while
# DEMO_DATA is not false, ADMIN_PASSWORD is the demo password or any account accepts the demo password.
# ADMIN_PASSWORD=
# DEMO_DATA=false
# Local homologation only (e.g. compose.local.yaml on 0.0.0.0 over HTTP): explicit opt-out of that check.
# Ignored when SECURE_COOKIE=true. Never set on a public server.
# URBANA_ALLOW_INSECURE_DEMO=true

# Public deployment / Web Push (generate keys with npm.cmd run push:keys)
# URBANA_DOMAIN=campo.seudominio.gov.br
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:suporte@seudominio.gov.br
# SECURE_COOKIE=true also enables HSTS (max-age one year) and CSP upgrade-insecure-requests.
# SECURE_COOKIE=true
# Behind a reverse proxy: trusted hops for X-Forwarded-For (login and citizen-portal limits per client). Compose sets 1 (Caddy).
# TRUST_PROXY=1

# Portal do cidadão (/portal and /portal/acompanhar, public, no login): off by default, turned on in
# Administração > Configurações (consent text and limits are there too). URBANA_PUBLIC_PORTAL=off forces it
# off whatever the setting says (deployment kill switch, e.g. an internal-only instance or under abuse);
# unset or any other value leaves the decision to the setting. Off = /api/publico/* answers 404.
# URBANA_PUBLIC_PORTAL=off

# Frontend: applied by Vite at build time. Empty = OpenStreetMap. Use /map-development-tile.svg for an offline test grid.
# The server also reads VITE_MAP_TILE_URL at runtime to allow the tile host in the Content-Security-Policy
# (img-src); keep the same value for build and runtime.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_MAP_MAX_ZOOM=19

# Logs: LOG_LEVEL = debug | info | warn | error | silent (default info; silent under `node --test`).
# LOG_FORMAT = json | text (default json when NODE_ENV=production, text otherwise).
# LOG_LEVEL=info
# LOG_FORMAT=json

# Orphan upload sweep inside the server process (opt-in, local file storage only). 0/unset = off.
# Removes uploads/invoices files with no database row older than the grace period (hours, minimum 1).
# Manual run / dry run: npm run uploads:cleanup -- --dry-run
# UPLOAD_SWEEP_INTERVAL_HOURS=24
# UPLOAD_SWEEP_GRACE_HOURS=24

# Backup (npm run backup): destination folder and how many backups to keep (0 = keep all).
# PostgreSQL backups need pg_dump compatible with the server (PG_DUMP_BIN overrides the binary).
# BACKUP_DIR=backups
# BACKUP_KEEP=14
# PG_DUMP_BIN=pg_dump

# Antimalware for uploads (optional, off by default). Set CLAMAV_HOST to scan evidence and invoice PDFs
# with ClamAV (clamd over TCP) before they are stored. In compose: CLAMAV_HOST=clamav and
# `docker compose --profile antimalware up -d`. Without CLAMAV_HOST nothing changes.
# CLAMAV_FAIL_MODE: closed (default) refuses uploads with 503 when clamd is down or slow;
# open accepts them and logs a warning. Infected files are always refused with 422.
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=10000
# CLAMAV_FAIL_MODE=closed
# clamd StreamMaxLength in bytes (default 26214400 = 25 MB; uploads are limited to 15 MB).
# CLAMAV_STREAM_MAX_BYTES=26214400
