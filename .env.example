PORT=3000
HOST=127.0.0.1
# Optional. Without DATABASE_URL, uses SQLite in ./data.
# DATABASE_URL=postgres://urban:urban@localhost:5432/urban
# Set before first startup; never use demonstration passwords on a public server.
# ADMIN_PASSWORD=
# DEMO_DATA=false

# Public deployment / Web Push (generate keys with npm.cmd run push:keys)
# URBANA_DOMAIN=campo.seudominio.gov.br
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:suporte@seudominio.gov.br
# SECURE_COOKIE=true

# Frontend: applied by Vite at build time. Empty = local development grid, no external tiles.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_MAP_MAX_ZOOM=19
